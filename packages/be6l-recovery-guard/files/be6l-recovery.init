#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
USE_PROCD=1
START=95
STOP=01

start_service() {
	local enabled grace timeout interval force_after
	config_load be6l-recovery
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0
	config_get grace main boot_grace 600
	config_get timeout main disconnect_timeout 300
	config_get interval main poll_interval 5
	config_get force_after main force_after 30
	procd_open_instance
	procd_set_param command /usr/sbin/be6l-recovery-guard run "$grace" "$timeout" "$interval" "$force_after"
	procd_set_param respawn 3600 5 0
	# Give the daemon time for its one forced-reboot fallback during shutdown.
	procd_set_param term_timeout 45
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger be6l-recovery
}
