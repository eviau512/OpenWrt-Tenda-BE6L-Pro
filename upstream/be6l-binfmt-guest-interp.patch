+	if (!phdrs)
+		return -ENOEXEC;
+	for (i = 0; i < header.e_phnum; i++) {
+		if (phdrs[i].p_type != PT_INTERP)
+			continue;
+		if (phdrs[i].p_filesz < 2 || phdrs[i].p_filesz > PATH_MAX)
+			goto out;
