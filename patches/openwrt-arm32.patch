diff --git a/package/kernel/mt76/patches/996-mt7996-quarantine-retired-native-wcids.patch b/package/kernel/mt76/patches/996-mt7996-quarantine-retired-native-wcids.patch
new file mode 100644
index 000000000..5f226c4f2
--- /dev/null
+++ b/package/kernel/mt76/patches/996-mt7996-quarantine-retired-native-wcids.patch
@@ -0,0 +1,50 @@
+Subject: [PATCH] mt7996: quarantine retired native RX WCIDs until DMA reset
+
+Removing a station retires its generation-less native RX identity.
+The allocator previously reused that WCID immediately, causing the
+key gate to reject ordinary reassociation and request a full reset.
+Keep retired WCIDs allocated and skip any retired free slot. When
+the table fills, request the existing full reset before reuse.
+Replay, identity, DMA ownership and key-reinstall checks remain intact.
+
+---
+
+--- a/mt7996/main.c
++++ b/mt7996/main.c
+@@ -1791,9 +1791,22 @@
+ 		idx = msta->reset_wcid[link_id] - 1;
+ 		msta->reset_wcid[link_id] = 0;
+ 	} else {
+-		idx = mt76_wcid_alloc(dev->mt76.wcid_mask, MT7996_WTBL_STA);
+-		if (idx < 0)
+-			return -ENOSPC;
++		/* Native RX descriptors carry no generation. Keep a retired WCID
++		 * reserved until the existing full radio/RRO/DMA reset completes.
++		 * Never give a new peer or key an old descriptor identity.
++		 */
++		do {
++			idx = mt76_wcid_alloc(dev->mt76.wcid_mask, MT7996_WTBL_STA);
++			if (idx < 0) {
++				if (dev->mt76.mmio.an7552 &&
++				    !bitmap_empty(dev->npu_rx_retired, MT76_N_WCIDS)) {
++					dev->recovery.restart = true;
++					queue_work(dev->mt76.wq, &dev->reset_work);
++				}
++				return -ENOSPC;
++			}
++		} while (dev->mt76.mmio.an7552 &&
++			 test_bit(idx, dev->npu_rx_retired));
+ 	}
+ 
+ 	if (mt7996_sta_deflink_busy(dev, msta)) {
+@@ -1906,7 +1919,9 @@
+ 
+ 		rcu_assign_pointer(msta->link[link_id], NULL);
+ 		rcu_assign_pointer(dev->mt76.wcid[msta_link->wcid.idx], NULL);
+-		mt76_wcid_mask_clear(dev->mt76.wcid_mask, msta_link->wcid.idx);
++		if (!dev->mt76.mmio.an7552 ||
++		    !test_bit(msta_link->wcid.idx, dev->npu_rx_retired))
++			mt76_wcid_mask_clear(dev->mt76.wcid_mask, msta_link->wcid.idx);
+ 		if (msta_link != &msta->deflink)
+ 			kfree_rcu(msta_link, rcu_head);
+ 	}
