@@ -0,0 +1,13 @@
+# Experimental AArch64 profile: deliberately no flash image or bootloader.
+define Device/tenda_be6l-pro
+  DEVICE_VENDOR := Tenda
+  DEVICE_MODEL := BE6L Pro (AArch64 RAM experiment)
+  DEVICE_DTS := an7563-tenda-be6l-pro
+  DEVICE_PACKAGES := an7552-npu-firmware airoha-en8811h-firmware \
+    kmod-phy-airoha-en8811h kmod-mt7996e kmod-mt7992-23-firmware \
+    wpad-mbedtls iw
+  KERNEL_LOADADDR := 0x80200000
+  IMAGES :=
+  ARTIFACTS :=
+endef
+TARGET_DEVICES += tenda_be6l-pro
diff --git a/target/linux/airoha/patches-6.18/963-mtd-bmt-honor-read-only.patch b/target/linux/airoha/patches-6.18/963-mtd-bmt-honor-read-only.patch
new file mode 100644
index 000000000..aad848051
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/963-mtd-bmt-honor-read-only.patch
@@ -0,0 +1,51 @@
+From: eviau512 <121651381+eviau512@users.noreply.github.com>
+Subject: [PATCH] mtd: honor flash read-only before BMT initialization
+
+RAM-only testing must also prohibit internal BMT metadata creation and repair.
+Keep reads and address translation available for factory calibration data.
+Fail probe if existing metadata cannot be loaded without a physical write.
+Retain Airoha's transaction locking wrappers around every translated operation.
+
+Signed-off-by: eviau512 <121651381+eviau512@users.noreply.github.com>
+---
+--- a/drivers/mtd/nand/mtk_bmt.c
++++ b/drivers/mtd/nand/mtk_bmt.c
+@@ -367,6 +367,22 @@
+ 	return ret;
+ }
+ 
++static int mtk_bmt_readonly_write(struct mtd_info *mtd, loff_t to,
++				  struct mtd_oob_ops *ops)
++{
++	return -EROFS;
++}
++
++static int mtk_bmt_readonly_erase(struct mtd_info *mtd, struct erase_info *instr)
++{
++	return -EROFS;
++}
++
++static int mtk_bmt_readonly_markbad(struct mtd_info *mtd, loff_t ofs)
++{
++	return -EROFS;
++}
++
+ static void
+ mtk_bmt_replace_ops(struct mtd_info *mtd)
+ {
+@@ -375,6 +391,15 @@
+ 	bmtd._erase = mtd->_erase;
+ 	bmtd._block_isbad = mtd->_block_isbad;
+ 	bmtd._block_markbad = mtd->_block_markbad;
++
++	if (bmtd.ops == &airoha_bmt_ops &&
++	    of_property_read_bool(mtd_get_of_node(mtd), "airoha,bmt-read-only")) {
++		bmtd._write_oob = mtk_bmt_readonly_write;
++		bmtd._erase = mtk_bmt_readonly_erase;
++		bmtd._block_markbad = mtk_bmt_readonly_markbad;
++		mtd->flags &= ~MTD_WRITEABLE;
++		pr_info("mtk-bmt: physical writes disabled for RAM-only bring-up\n");
++	}
+ 
+ 	mtd->_read_oob = airoha_locked_read;
+ 	mtd->_write_oob = airoha_locked_write;
