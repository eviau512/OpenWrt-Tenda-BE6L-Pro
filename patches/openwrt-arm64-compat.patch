++ * Consumers must check valid, version and producer before using the snapshot.
++ */
++#define FLOW_RULE_CT_CONTEXT_VERSION 1
++#define FLOW_RULE_CT_CONTEXT_NF_FLOWTABLE 1
++struct flow_rule_ct_context {
++	u16 version;
++	u8 producer;
++	u8 valid;
++	u16 zone_id;
++	u16 zone_raw_id;
++	u8 zone_dir;
++	u8 zone_flags;
++	u8 direction;
++	u8 initial_netns;
++	u32 reserved;
++};
++
+@@ -442,0 +462 @@
++	struct flow_rule_ct_context ct_context;
+--- a/net/netfilter/nf_flow_table_offload.c
++++ b/net/netfilter/nf_flow_table_offload.c
+@@ -14,0 +15 @@
++#include <net/netfilter/nf_conntrack_zones.h>
+@@ -799,0 +801,33 @@
++/* The flow table holds the CT reference while this rule is constructed.
++ * No pointer escapes; this describes the approved CT, not every later packet.
++ */
++static bool
++nf_flow_rule_set_ct_context(struct flow_rule *rule, const struct net *net,
++			    const struct flow_offload *flow,
++			    enum flow_offload_tuple_dir dir)
++{
++	struct flow_rule_ct_context *context = &rule->ct_context;
++	const struct nf_conntrack_zone *zone;
++	enum ip_conntrack_dir ct_dir;
++
++	memset(context, 0, sizeof(*context));
++	if ((unsigned int)dir >= FLOW_OFFLOAD_DIR_MAX ||
++	    !net_eq(nf_ct_net(flow->ct), net))
++		return false;
++
++	ct_dir = dir == FLOW_OFFLOAD_DIR_ORIGINAL ?
++		 IP_CT_DIR_ORIGINAL : IP_CT_DIR_REPLY;
++	zone = nf_ct_zone(flow->ct);
++	context->version = FLOW_RULE_CT_CONTEXT_VERSION;
++	context->producer = FLOW_RULE_CT_CONTEXT_NF_FLOWTABLE;
++	context->zone_id = nf_ct_zone_id(zone, ct_dir);
++	context->zone_raw_id = zone->id;
++	context->zone_dir = zone->dir;
++	context->zone_flags = zone->flags;
++	context->direction = dir;
++	context->initial_netns = net_eq(net, &init_net);
