++	    context->producer != FLOW_RULE_CT_CONTEXT_NF_FLOWTABLE ||
++	    context->direction > 1 || context->reserved ||
++	    context->initial_netns > 1)
++		return "AN7563 routed offload lacks explicit flowtable CT context";
++	if (!context->initial_netns)
++		return "AN7563 routed offload requires the initial network namespace";
++	if (context->zone_id || context->zone_raw_id || context->zone_flags ||
++	    context->zone_dir != 3)
++		return "AN7563 routed offload requires an explicit default CT zone";
++	return "AN7563 routed classification is not implemented";
++}
++
+@@ -1937 +1957,3 @@
+-	if (airoha_is_7563(eth) && addr_type)
++	if (airoha_is_7563(eth) && addr_type) {
++		NL_SET_ERR_MSG_FMT_MOD(f->common.extack, "%s",
++				   airoha_ppe_routed_context_error(&rule->ct_context));
+@@ -1938,0 +1961 @@
++	}
