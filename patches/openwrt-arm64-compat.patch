++++ b/drivers/pinctrl/airoha/Kconfig
+@@ -46,7 +46,7 @@
+ 
+ config PINCTRL_AIROHA_AN7563
+ 	tristate "AN7563 pinctrl"
+-	depends on ARM || COMPILE_TEST
++	depends on ARM || ARM64 || COMPILE_TEST
+ 	depends on PINCTRL_AIROHA
+ 	help
+ 	  Pin controller and GPIO support for AN7563/AN7552.
diff --git a/target/linux/airoha/patches-6.18/971-net-airoha-use-fixed-an7563-rx-offset.patch b/target/linux/airoha/patches-6.18/971-net-airoha-use-fixed-an7563-rx-offset.patch
new file mode 100644
index 000000000..b3e65a012
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/971-net-airoha-use-fixed-an7563-rx-offset.patch
@@ -0,0 +1,85 @@
+Subject: [PATCH] net: airoha: use AN7563 hardware RX offset on arm64
+
+AN7563's QDMA initialization always enables a two-byte receive offset,
+but arm64 defines NET_IP_ALIGN as zero. Deriving the posted buffer and
+skb positions from NET_IP_ALIGN therefore leaves every ordinary frame
+two bytes out of position and prevents DHCP on both wired interfaces.
+
+Use the hardware offset for AN7563 buffer sizing, posting, skb headroom
+and scattered receive restoration. ARM32 and other SoCs retain their
+existing layout. DMA ownership and bounds checks remain unchanged.
+
+---
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -548,6 +548,17 @@
+ 			     LRO_RXQ_EN_MASK);
+ }
+ 
++/* AN7563 always enables the hardware two-byte RX offset. This is a DMA
++ * layout requirement, independent of the host's NET_IP_ALIGN (zero on arm64).
++ */
++#define AN7563_RX_DMA_OFFSET 2
++static __always_inline u32 airoha_qdma_rx_headroom(const struct airoha_queue *q)
++{
++	u32 offset = airoha_is_7563(q->qdma->eth) ? AN7563_RX_DMA_OFFSET : NET_IP_ALIGN;
++
++	return NET_SKB_PAD + offset;
++}
++
+ static void airoha_dev_lro_enable(struct airoha_gdm_dev *dev)
+ {
+ 	struct airoha_qdma *qdma = airoha_qdma_deref(dev);
+@@ -568,7 +579,7 @@
+ 		if (!airoha_qdma_is_lro_queue(q))
+ 			continue;
+ 
+-		size = SKB_WITH_OVERHEAD(AIROHA_RX_LEN(q->buf_size));
++		size = SKB_WITH_OVERHEAD((q->buf_size - airoha_qdma_rx_headroom(q)));
+ 		size = min_t(u32, size, AIROHA_MAX_RX_SIZE);
+ 		airoha_fe_lro_rxq_enable(eth, qdma_id, lro_queue_index, i,
+ 					 size);
+@@ -713,10 +724,10 @@
+ 		q->queued++;
+ 		nframes++;
+ 
+-		offset += AIROHA_RX_HEADROOM;
++		offset += airoha_qdma_rx_headroom(q);
+ 		e->buf = page_address(page) + offset;
+ 		e->dma_addr = page_pool_get_dma_addr(page) + offset;
+-		e->dma_len = SKB_WITH_OVERHEAD(AIROHA_RX_LEN(q->buf_size));
++		e->dma_len = SKB_WITH_OVERHEAD((q->buf_size - airoha_qdma_rx_headroom(q)));
+ 
+ 		WRITE_ONCE(desc->tcp_ts_reply, 0);
+ 		val = FIELD_PREP(QDMA_DESC_LEN_MASK, e->dma_len);
+@@ -925,13 +936,13 @@
+ 		 */
+ 		rx_offset = airoha_is_7563(eth) &&
+ 			    (q->skb || (desc_ctrl & QDMA_DESC_MORE_MASK)) ?
+-			    NET_IP_ALIGN : 0;
++			    AN7563_RX_DMA_OFFSET : 0;
+ 		dma_sync_single_for_cpu(eth->dev, e->dma_addr - rx_offset,
+ 					e->dma_len + rx_offset, dir);
+ 
+ 		page = virt_to_head_page(e->buf);
+ 		len = FIELD_GET(QDMA_DESC_LEN_MASK, desc_ctrl);
+-		data_len = q->skb ? AIROHA_RX_LEN(q->buf_size) : e->dma_len;
++		data_len = q->skb ? (q->buf_size - airoha_qdma_rx_headroom(q)) : e->dma_len;
+ 		if (!len || data_len < len)
+ 			goto free_frag;
+ 
+@@ -948,12 +959,12 @@
+ 			 */
+ 			if (rx_offset)
+ 				memmove(e->buf, e->buf - rx_offset, len);
+-			q->skb = napi_build_skb(e->buf - AIROHA_RX_HEADROOM,
++			q->skb = napi_build_skb(e->buf - airoha_qdma_rx_headroom(q),
+ 						q->buf_size);
+ 			if (!q->skb)
+ 				goto free_frag;
+ 
+-			skb_reserve(q->skb, AIROHA_RX_HEADROOM);
++			skb_reserve(q->skb, airoha_qdma_rx_headroom(q));
+ 			__skb_put(q->skb, len);
+ 			skb_mark_for_recycle(q->skb);
+ 			q->skb->dev = netdev;
diff --git a/target/linux/airoha/patches-6.18/972-net-airoha-do-not-use-an7563-foe-slot-as-rx-hash.patch b/target/linux/airoha/patches-6.18/972-net-airoha-do-not-use-an7563-foe-slot-as-rx-hash.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/972-net-airoha-do-not-use-an7563-foe-slot-as-rx-hash.patch
@@ -0,0 +1,22 @@
+Subject: [PATCH] net: airoha: do not use AN7563 FOE slots as RX flow hashes
+
+The native AN7563 classifier currently handles L2 traffic only. CPU-routed
+packets from unrelated TCP flows can carry the same FOE metadata value.
+Marking its jhash as a valid L4 hash prevents software dissection and pins
+RPS to one CPU, even when both CPUs are in the receive map.
+
+Leave the skb hash unset on AN7563 so Linux can hash the actual packet.
+Keep the raw FOE index for PPE learning, and retain the routed-rule guard.
+Other SoCs keep their existing receive-hash behavior.
+
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -1014,4 +1014,7 @@
+ 		hash = FIELD_GET(AIROHA_RXD4_FOE_ENTRY, msg1);
+-		if (hash != AIROHA_RXD4_FOE_ENTRY)
++		/* Native AN7563 routed traffic can share one FOE metadata value.
++		 * Let the stack dissect it instead of claiming a valid L4 hash.
++		 */
++		if (!airoha_is_7563(eth) && hash != AIROHA_RXD4_FOE_ENTRY)
+ 			skb_set_hash(q->skb, jhash_1word(hash, 0),
+ 				     PKT_HASH_TYPE_L4);
