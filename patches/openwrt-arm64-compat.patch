diff --git a/target/linux/airoha/an7563a64/base-files/etc/uci-defaults/09_xiaomi-be5000-wifi-macaddr b/target/linux/airoha/an7563a64/base-files/etc/uci-defaults/09_xiaomi-be5000-wifi-macaddr
new file mode 100644
index 000000000..8df727420
--- /dev/null
+++ b/target/linux/airoha/an7563a64/base-files/etc/uci-defaults/09_xiaomi-be5000-wifi-macaddr
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+# Without its Wi-Fi calibration in "art", mt7996 loads the MediaTek default
+# EEPROM, whose MAC address is the same on every unit. Give each radio a
+# random locally administered base once; it is kept in the config.
+
+. /lib/functions.sh
+. /lib/functions/system.sh
+
+[ "$(board_name)" = xiaomi,be5000 ] || exit 0
+[ "$(cat /sys/class/ieee80211/phy0/macaddress 2>/dev/null)" = 00:0c:43:26:60:10 ] || exit 0
+
+# Idempotent: adds only the radios that have no wifi-device section yet.
+/sbin/wifi config
+
+base=$(macaddr_random)
+idx=0
+for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
+	[ -n "$(uci -q get wireless.$radio.macaddr_base)" ] && continue
+	uci set wireless.$radio.macaddr_base=$(macaddr_add "$base" $((idx * 16)))
+	idx=$((idx + 1))
+done
+uci commit wireless
+
+exit 0
diff --git a/target/linux/airoha/an7563a64/base-files/lib/preinit/75_ubi_rootfs_data b/target/linux/airoha/an7563a64/base-files/lib/preinit/75_ubi_rootfs_data
new file mode 100644
index 000000000..15b87c3db
--- /dev/null
+++ b/target/linux/airoha/an7563a64/base-files/lib/preinit/75_ubi_rootfs_data
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+# JFFS2 on the SPI-NAND of the Xiaomi BE5000 corrupts pages it programs
+# twice (cleanmarker in OOB, then data), so the overlay lives in a UBI
+# volume. Attach an existing "ubi" partition and create
+# the rootfs_data volume, with its /dev node, before mount_root looks
+# for it. An initramfs may run on a factory layout, where formatting
+# would destroy stock data: leave the flash alone there.
+
+. /lib/upgrade/nand.sh
+
+ubi_rootfs_data() {
+	local mtdnum ubidev
+
+	[ "$INITRAMFS" = "1" ] && return 0
+	case "$(board_name)" in
+	xiaomi,be5000) ;;
+	*) return 0 ;;
+	esac
+
+	mtdnum="$(find_mtd_index ubi)"
+	[ -n "$mtdnum" ] || return 0
+
+	ubidev="$(nand_find_ubi ubi)"
+	if [ -z "$ubidev" ]; then
+		# A failed attachment does not mean the existing data is disposable.
+		# Formatting is reserved for an explicit sysupgrade operation.
+		ubiattach -m "$mtdnum" >/dev/null || {
+			echo "Cannot attach UBI on mtd$mtdnum; preserving flash." >&2
+			return 1
+		}
+		ubidev="$(nand_find_ubi ubi)"
+		[ -n "$ubidev" ] || return 1
+	fi
+
+	[ -n "$(nand_find_volume "$ubidev" rootfs_data)" ] && return 0
+
+	echo "- creating rootfs_data UBI volume -"
+	ubimkvol "/dev/$ubidev" -N rootfs_data -m >/dev/null || return 1
+	# The node of the new volume does not exist yet in preinit, and
+	# mount_root opens the volume by it: nand_find_volume() creates it.
+	nand_find_volume "$ubidev" rootfs_data >/dev/null
+}
+
+boot_hook_add preinit_main ubi_rootfs_data
diff --git a/target/linux/airoha/an7563a64/base-files/lib/upgrade/platform.sh b/target/linux/airoha/an7563a64/base-files/lib/upgrade/platform.sh
new file mode 100644
index 000000000..c1d105cf7
--- /dev/null
+++ b/target/linux/airoha/an7563a64/base-files/lib/upgrade/platform.sh
@@ -0,0 +1,59 @@
+# SPDX-License-Identifier: GPL-2.0-only
+
+PART_NAME=firmware
+REQUIRE_IMAGE_METADATA=1
+
+platform_check_image() {
+	case "$(board_name)" in
+	xiaomi,be5000|airoha,an7563-evb)
+		[ "$(get_magic_long "$1")" = "d00dfeed" ] && return 0
+		echo "Expected an AN7563 FIT firmware image."
+		return 1
+		;;
+	esac
+	echo "Unsupported board."
+	return 1
+}
+
+# The FIT stays raw in "firmware" (the bootloader reads it from there),
+# the overlay is the rootfs_data volume in the "ubi" partition.
+xiaomi_be5000_do_upgrade() {
+	local ubidev
+
+	# Old kernels do not expose the new UBI partition. Boot the new
+	# initramfs before migrating; never write an image we cannot provision.
+	[ -n "$(find_mtd_index ubi)" ] || {
+		echo "Boot the new initramfs before migrating to the UBI layout." >&2
+		return 1
+	}
+	# An explicit upgrade may initialize the overlay partition. Normal
+	# preinit only attempts attachment and never formats on an error.
+	ubidev="$(nand_attach_ubi ubi)" || return 1
+	[ -n "$ubidev" ] || return 1
+
+	get_image "$1" | mtd write - "$PART_NAME" || return 1
+
+	[ -n "$(nand_find_volume "$ubidev" rootfs_data)" ] && \
+		{ ubirmvol "/dev/$ubidev" -N rootfs_data || return 1; }
+	ubimkvol "/dev/$ubidev" -N rootfs_data -m || return 1
+
+	if [ -n "$UPGRADE_BACKUP" ]; then
+		CI_UBIPART=ubi nand_restore_config "$UPGRADE_BACKUP" || return 1
+	fi
+	return 0
+}
+
+platform_do_upgrade() {
+	case "$(board_name)" in
+	tenda,be6l-pro)
+		echo "BE6L Pro RAM-only bring-up: flash upgrades disabled." >&2
+		return 1
+		;;
+	xiaomi,be5000)
+		xiaomi_be5000_do_upgrade "$1"
+		;;
+	*)
+		default_do_upgrade "$1"
+		;;
+	esac
+}
