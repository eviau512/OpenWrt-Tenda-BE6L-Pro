diff --git a/target/linux/airoha/patches-6.18/966-net-airoha-quiesce-inherited-idle-sdk-ppe-tx-ring.patch b/target/linux/airoha/patches-6.18/966-net-airoha-quiesce-inherited-idle-sdk-ppe-tx-ring.patch
new file mode 100644
index 000000000..ad5cb5bbe
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/966-net-airoha-quiesce-inherited-idle-sdk-ppe-tx-ring.patch
@@ -0,0 +1,78 @@
+From: BE6L Pro RAM bring-up
+Subject: [PATCH] net: airoha: quiesce an inherited idle SDK TX ring
+
+--- a/drivers/net/ethernet/airoha/an7552_npu.c
++++ b/drivers/net/ethernet/airoha/an7552_npu.c
+@@ -516,17 +516,58 @@
+ 	}
+ }
+ 
++/* A warm boot can retain the SDK's idle SRAM TX ring. Its NPU producer
++ * has already been stopped by boot_firmware(). Never claim another ring,
++ * pending descriptors, or a live DMA transaction. Timeout leaves TX stopped.
++ */
++static int native_ppe_quiesce_boot_tx(struct an7552_npu *ctx)
++{
++	u32 producer, consumer, global, value;
++	int ret;
++
++	if (readl(ctx->fe + 0x800) != 0x1e800000 ||
++	    readl(ctx->fe + 0x804) != 0x00050400)
++		return -EBUSY;
++	producer = readl(ctx->fe + 0x808);
++	consumer = readl(ctx->fe + 0x80c);
++	global = readl(ctx->fe + 0xa04);
++	if (producer != consumer || consumer >= 64 || (global & BIT(1)) ||
++	    (readl(ctx->fe + 0xfe4) & 0xffff))
++		return -EBUSY;
++
++	writel(global & ~BIT(0), ctx->fe + 0xa04);
++	ret = readl_poll_timeout(ctx->fe + 0xa04, value, !(value & BIT(1)),
++				 10, 100000);
++	if (ret)
++		return ret;
++	if (readl(ctx->fe + 0x800) != 0x1e800000 ||
++	    readl(ctx->fe + 0x804) != 0x00050400 ||
++	    readl(ctx->fe + 0x808) != producer ||
++	    readl(ctx->fe + 0x80c) != consumer ||
++	    (readl(ctx->fe + 0xfe4) & 0xffff))
++		return -EBUSY;
++
++	dev_info(ctx->dev, "quiesced inherited idle SDK PPE TX ring\n");
++	return 0;
++}
++
+ static int native_ppe_start(struct an7552_npu *ctx)
+ {
+ 	void __iomem *q = ctx->regs + 0x36c0, *ring = ctx->ram + 0x2f0000;
+ 	unsigned int i;
+ 	u32 start;
++	int ret;
+ 
+ 	if (ctx->ppe_enabled)
+ 		return 0;
+ 	if (!ctx->bridge_domains)
+ 		return -EOPNOTSUPP;
+-	if (readl(ctx->fe + 0x800) || (readl(ctx->fe + 0xa04) & 3) ||
++	if (readl(ctx->fe + 0x800)) {
++		ret = native_ppe_quiesce_boot_tx(ctx);
++		if (ret)
++			return ret;
++	}
++	if ((readl(ctx->fe + 0xa04) & 3) ||
+ 	    (readl(ctx->fe + 0xfe4) & 65535))
+ 		goto busy;
+ 	start = readl(ctx->fe + 0x80c);
+@@ -747,9 +788,10 @@
+ 	writel(BIT(18), ctx->regs + 0x30d030);
+ 	/* Publish receive rings before allowing the firmware to consume them. */
+ 	wmb();
+-	if (native_ppe_start(ctx))
++	ret = native_ppe_start(ctx);
++	if (ret)
+ 		dev_warn(ctx->dev,
+-			 " PPE setup failed, keeping CPU receive path\n");
++			 "PPE setup failed (%d), keeping CPU receive path\n", ret);
+ 	writel(1, q + 16);
+ 	an7552_npu_rro_irq_enable(ctx);
+ 	dev_dbg(ctx->dev,
diff --git a/target/linux/airoha/patches-6.18/967-net-airoha-fix-an7563-scattered-rx-alignment.patch b/target/linux/airoha/patches-6.18/967-net-airoha-fix-an7563-scattered-rx-alignment.patch
new file mode 100644
index 000000000..8ffeceb4b
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/967-net-airoha-fix-an7563-scattered-rx-alignment.patch
@@ -0,0 +1,64 @@
+Subject: [PATCH] net: airoha: fix AN7563 scattered RX alignment
+
+AN7563 ignores the two-byte receive offset for scattered buffers.
+The first and continuation buffers start two bytes before the normal
+software data pointer, causing frames over the 1KiB scatter boundary
+to be decoded with an invalid Ethernet header.
+
+Synchronize the actual DMA-written prefix, restore the first fragment
+to keep the IP header aligned, and correct continuation page offsets.
+Keep existing length checks and other SoCs unchanged.
+
+---
+
+diff --git a/drivers/net/ethernet/airoha/airoha_eth.c b/drivers/net/ethernet/airoha/airoha_eth.c
+--- a/drivers/net/ethernet/airoha/airoha_eth.c
++++ b/drivers/net/ethernet/airoha/airoha_eth.c
+@@ -907,7 +907,7 @@
+ 		u32 hash, reason, msg1, desc_ctrl;
+ 		struct airoha_gdm_dev *dev;
+ 		struct net_device *netdev;
+-		int data_len, len;
++		int data_len, len, rx_offset;
+ 		struct page *page;
+ 
+ 		desc_ctrl = le32_to_cpu(READ_ONCE(desc->ctrl));
+@@ -919,8 +919,15 @@
+ 		q->tail = (q->tail + 1) % q->ndesc;
+ 		q->queued--;
+ 
+-		dma_sync_single_for_cpu(eth->dev, e->dma_addr, e->dma_len,
+-					dir);
++		/* AN7563 ignores the two-byte RX offset for every buffer of a
++		 * scattered frame. The posted DMA address is rounded down,
++		 * including the final continuation descriptor without MORE.
++		 */
++		rx_offset = airoha_is_7563(eth) &&
++			    (q->skb || (desc_ctrl & QDMA_DESC_MORE_MASK)) ?
++			    NET_IP_ALIGN : 0;
++		dma_sync_single_for_cpu(eth->dev, e->dma_addr - rx_offset,
++					e->dma_len + rx_offset, dir);
+ 
+ 		page = virt_to_head_page(e->buf);
+ 		len = FIELD_GET(QDMA_DESC_LEN_MASK, desc_ctrl);
+@@ -936,6 +943,11 @@
+ 		netdev = netdev_from_priv(dev);
+ 
+ 		if (!q->skb) { /* first buffer */
++			/* Keep the IP header aligned after restoring the first
++			 * fragment to the normal skb data position.
++			 */
++			if (rx_offset)
++				memmove(e->buf, e->buf - rx_offset, len);
+ 			q->skb = napi_build_skb(e->buf - AIROHA_RX_HEADROOM,
+ 						q->buf_size);
+ 			if (!q->skb)
+@@ -964,7 +976,7 @@
+ 				goto free_frag;
+ 
+ 			skb_add_rx_frag(q->skb, nr_frags, page,
+-					e->buf - page_address(page), len,
++					e->buf - page_address(page) - rx_offset, len,
+ 					q->buf_size);
+ 		}
+ 
diff --git a/target/linux/airoha/patches-6.18/968-PCI-mediatek-restore-erased-be6l-mt7992-bars.patch b/target/linux/airoha/patches-6.18/968-PCI-mediatek-restore-erased-be6l-mt7992-bars.patch
new file mode 100644
index 000000000..32ee7b712
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/968-PCI-mediatek-restore-erased-be6l-mt7992-bars.patch
@@ -0,0 +1,103 @@
+Subject: [PATCH] PCI: mediatek: restore erased MT7992 BARs on BE6L RAM handoff
+
+The stock-to-RAM handoff can erase the two MT7992 functions BARs
+after enumeration but before the wireless driver enables them.
+Use the PCI core allocation, not a rescan or hard-coded addresses.
+Restrict recovery to BE6L on AN7563 with recognized erased BARs
+and bus mastering disabled; reject unknown or active-DMA states.
+The reset trigger remains under investigation.
+
+---
+
+diff --git a/drivers/pci/controller/pcie-mediatek.c b/drivers/pci/controller/pcie-mediatek.c
+--- a/drivers/pci/controller/pcie-mediatek.c
++++ b/drivers/pci/controller/pcie-mediatek.c
+@@ -1198,6 +1198,79 @@
+ 	return 0;
+ }
+ 
++/*
++ * BE6L stock-to-RAM handoff can reset both MT7992 functions after PCI
++ * enumeration, erasing their BARs before mt76 probes. Keep the resources
++ * allocated by the PCI core; restore only an erased, recognized BAR while
++ * bus mastering is off. Unknown BAR contents or active DMA fail closed.
++ */
++static int an7563_pcie_enable_device(struct pci_host_bridge *host,
++				     struct pci_dev *dev)
++{
++	struct pci_bus_region regions[2];
++	u32 expected[2], values[2], upper;
++	u16 command;
++	unsigned int i;
++	bool restore = false;
++
++	if (dev->vendor != PCI_VENDOR_ID_MEDIATEK ||
++	    (dev->device != 0x7992 && dev->device != 0x799a))
++		return 0;
++
++	if (pci_read_config_word(dev, PCI_COMMAND, &command))
++		return -EIO;
++	for (i = 0; i < 2; i++) {
++		unsigned int index = i * 2;
++		struct resource *res = pci_resource_n(dev, index);
++
++		if (!res->parent || !res->start ||
++		    !(res->flags & IORESOURCE_MEM) ||
++		    !(res->flags & IORESOURCE_MEM_64) ||
++		    (res->flags & (IORESOURCE_UNSET | IORESOURCE_PREFETCH)) ||
++		    resource_size(res) != (i ? 0x8000 : 0x200000))
++			return -EINVAL;
++		pcibios_resource_to_bus(dev->bus, &regions[i], res);
++		if (upper_32_bits(regions[i].start))
++			return -EINVAL;
++		expected[i] = lower_32_bits(regions[i].start) |
++			      PCI_BASE_ADDRESS_MEM_TYPE_64;
++		if (pci_read_config_dword(dev, PCI_BASE_ADDRESS_0 + index * 4,
++					  &values[i]) ||
++		    pci_read_config_dword(dev, PCI_BASE_ADDRESS_0 + (index + 1) * 4,
++					  &upper) || upper)
++			return -EIO;
++		if (values[i] == expected[i])
++			continue;
++		if (values[i] != PCI_BASE_ADDRESS_MEM_TYPE_64)
++			return -EIO;
++		restore = true;
++	}
++	if (!restore)
++		return 0;
++	if (command & PCI_COMMAND_MASTER)
++		return -EBUSY;
++
++	if (pci_write_config_word(dev, PCI_COMMAND,
++				  command & ~PCI_COMMAND_MEMORY))
++		return -EIO;
++	for (i = 0; i < 2; i++) {
++		unsigned int index = i * 2;
++		u32 value;
++
++		if (values[i] == expected[i])
++			continue;
++		pci_update_resource(dev, index);
++		if (pci_read_config_dword(dev, PCI_BASE_ADDRESS_0 + index * 4,
++					  &value) || value != expected[i] ||
++		    pci_read_config_dword(dev, PCI_BASE_ADDRESS_0 + (index + 1) * 4,
++					  &upper) || upper)
++			return -EIO;
++		pci_info(dev, "restored erased BAR%u to assigned resource %pR\n",
++			 index, pci_resource_n(dev, index));
++	}
++	return pci_write_config_word(dev, PCI_COMMAND, command) ? -EIO : 0;
++}
++
+ static int mtk_pcie_probe(struct platform_device *pdev)
+ {
+ 	struct device *dev = &pdev->dev;
+@@ -1223,6 +1296,8 @@
+ 	host->ops = pcie->soc->ops;
+ 	host->sysdata = pcie;
+ 	host->msi_domain = pcie->soc->no_msi;
++	if (pcie->soc->an7563 && of_machine_is_compatible("tenda,be6l-pro"))
++		host->enable_device = an7563_pcie_enable_device;
+ 
+ 	err = pci_host_probe(host);
+ 	if (err)
diff --git a/target/linux/airoha/patches-6.18/969-net-airoha-preserve-idle-ppe-ring-position.patch b/target/linux/airoha/patches-6.18/969-net-airoha-preserve-idle-ppe-ring-position.patch
new file mode 100644
index 000000000..291241c70
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/969-net-airoha-preserve-idle-ppe-ring-position.patch
@@ -0,0 +1,121 @@
+Subject: [PATCH] net: airoha: preserve an idle PPE ring position on stop
+
+After native traffic the hardware TX consumer advances. Restoring
+the inherited producer from boot makes its idle SDK ring appear
+nonempty, so the next start correctly rejects it as busy.
+After stopping producers and draining, require the exact owned ring,
+equal stable indices, all DDONE bits, DMA stopped and empty PPE/FIFO.
+Only then restore an inherited idle ring at the proven idle position.
+Never write the hardware consumer or weaken takeover checks.
+
+---
+
+diff --git a/drivers/net/ethernet/airoha/an7552_npu.c b/drivers/net/ethernet/airoha/an7552_npu.c
+--- a/drivers/net/ethernet/airoha/an7552_npu.c
++++ b/drivers/net/ethernet/airoha/an7552_npu.c
+@@ -602,11 +602,62 @@
+ 	return -EBUSY;
+ }
+ 
++/* Call only after the native producers have stopped and PPE has drained.
++ * The hardware consumer is not restored with the ring registers. Returning
++ * the old producer would manufacture pending work in an inherited idle ring.
++ * Prove every native descriptor returned before preserving this idle index.
++ */
++static int native_ppe_restore_idle(struct an7552_npu *ctx)
++{
++	void __iomem *ring = ctx->ram + 0x2f0000;
++	u32 position = readl(ctx->fe + 0x80c);
++	unsigned int i;
++
++	if (ctx->ppe_saved[0] &&
++	    (ctx->ppe_saved[0] != 0x1e800000 ||
++	     ctx->ppe_saved[1] != 0x00050400))
++		return -EBUSY;
++	if (position >= 64 || readl(ctx->fe + 0x808) != position ||
++	    readl(ctx->fe + 0x800) != 0x042f0000 ||
++	    readl(ctx->fe + 0x804) != 64 ||
++	    (readl(ctx->fe + 0xa04) & 3) ||
++	    (readl(ctx->fe + 0xfe4) & 0xffff) ||
++	    (readl(ctx->fe + 0xe00) & BIT(31)))
++		return -EBUSY;
++	for (i = 0; i < 64; i++) {
++		if (!(readl(ring + i * 32 + 4) & BIT(31)))
++			return -EBUSY;
++	}
++	/* Fail closed if ownership or any ring register changed while scanning. */
++	if (readl(ctx->fe + 0x80c) != position ||
++	    readl(ctx->fe + 0x808) != position ||
++	    readl(ctx->fe + 0x800) != 0x042f0000 ||
++	    readl(ctx->fe + 0x804) != 64 ||
++	    (readl(ctx->fe + 0xa04) & 3) ||
++	    (readl(ctx->fe + 0xfe4) & 0xffff) ||
++	    (readl(ctx->fe + 0xe00) & BIT(31)))
++		return -EBUSY;
++
++	writel(ctx->ppe_saved[0], ctx->fe + 0x800);
++	writel(ctx->ppe_saved[1], ctx->fe + 0x804);
++	/* The consumer stays untouched, with no descriptor queued behind it. */
++	writel(position, ctx->fe + 0x808);
++	writel(ctx->ppe_saved[5], ctx->fe + 0xa28);
++	writel(ctx->ppe_saved[6], ctx->fe + 0xa2c);
++	writel(readl(ctx->fe + 0xa04) & ~BIT(0), ctx->fe + 0xa04);
++	if (readl(ctx->fe + 0x800) != ctx->ppe_saved[0] ||
++	    readl(ctx->fe + 0x804) != ctx->ppe_saved[1] ||
++	    readl(ctx->fe + 0x808) != position ||
++	    readl(ctx->fe + 0x80c) != position ||
++	    (readl(ctx->fe + 0xa04) & 3))
++		return -EIO;
++	return 0;
++}
++
+ static void native_ppe_stop(struct an7552_npu *ctx)
+ {
+ 	void __iomem *q = ctx->regs + 0x36c0;
+ 	u32 value;
+-	unsigned int i;
+ 	bool failed = false;
+ 
+ 	if (!ctx->ppe_enabled)
+@@ -632,11 +683,11 @@
+ 		ctx->failed = true;
+ 		return;
+ 	}
+-	for (i = 0; i < 3; i++)
+-		writel(ctx->ppe_saved[i], ctx->fe + 0x800 + i * 4);
+-	writel(ctx->ppe_saved[5], ctx->fe + 0xa28);
+-	writel(ctx->ppe_saved[6], ctx->fe + 0xa2c);
+-	writel(readl(ctx->fe + 0xa04) & ~BIT(0), ctx->fe + 0xa04);
++	if (native_ppe_restore_idle(ctx)) {
++		ctx->failed = true;
++		dev_err(ctx->dev, "native PPE ring still owned; retaining ring\n");
++		return;
++	}
+ 	ctx->ppe_enabled = false;
+ }
+ 
+@@ -1333,6 +1384,11 @@
+ 	ret = fault_drain_ppe(ctx);
+ 	if (ret)
+ 		return ret;
++	if (ctx->ppe_enabled) {
++		ret = native_ppe_restore_idle(ctx);
++		if (ret)
++			return ret;
++	}
+ 	for (band = 0; band < 2; band++) {
+ 		writel(0, ctx->regs + 0x30d034 + band * 4);
+ 		if (ctx->txfree_irqs[band]) {
+@@ -1350,12 +1406,6 @@
+ 		ctx->rro_irq = 0;
+ 	}
+ 	ctx->rro_notify = NULL;
+-	if (ctx->ppe_enabled) {
+-		for (i = 0; i < 3; i++)
+-			writel(ctx->ppe_saved[i], ctx->fe + 0x800 + i * 4);
+-		writel(ctx->ppe_saved[5], ctx->fe + 0xa28);
+-		writel(ctx->ppe_saved[6], ctx->fe + 0xa2c);
+-	}
+ 	ctx->ppe_enabled = false;
+ 	ctx->tdma_enabled = false;
+ 	ctx->fault_quiesced = true;
diff --git a/target/linux/airoha/patches-6.18/970-pinctrl-airoha-allow-an7563-on-arm64.patch b/target/linux/airoha/patches-6.18/970-pinctrl-airoha-allow-an7563-on-arm64.patch
new file mode 100644
index 000000000..e8257febe
--- /dev/null
+++ b/target/linux/airoha/patches-6.18/970-pinctrl-airoha-allow-an7563-on-arm64.patch
@@ -0,0 +1,17 @@
+Subject: [PATCH] pinctrl: airoha: allow AN7563 on AArch64
+
+AN7563 contains Cortex-A53 CPUs which can run either execution state.
+The SoC pin data uses the shared, architecture-independent Airoha driver,
