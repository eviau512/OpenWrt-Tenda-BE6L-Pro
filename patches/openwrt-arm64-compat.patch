++	    gdm->port->id == AIROHA_GDM1_IDX)
++		return 1;
++	if (dsa_port < 0 && conduit == netdev &&
++	    gdm->port->id == AIROHA_GDM2_IDX && !airoha_is_lan_gdm_dev(gdm))
