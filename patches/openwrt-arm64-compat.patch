diff --git a/target/linux/airoha/dts/an7563-tenda-be6l-pro.dts b/target/linux/airoha/dts/an7563-tenda-be6l-pro.dts
new file mode 100644
index 000000000..51b66512d
--- /dev/null
+++ b/target/linux/airoha/dts/an7563-tenda-be6l-pro.dts
@@ -0,0 +1,277 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/dts-v1/;
+
+/memreserve/ 0x80000000 0x88000;
+
+#include "an7563.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "Tenda BE6L Pro";
+	compatible = "tenda,be6l-pro", "airoha,an7563", "airoha,en7581";
+
+	aliases {
+		serial0 = &uart1;
+		led-boot = &led_status_green;
+		led-failsafe = &led_status_red;
+		led-running = &led_status_green;
+		led-upgrade = &led_status_red;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs = "console=ttyS0,115200n8 earlycon";
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x80000000 0x20000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* Matching workspace for the source-built AN7552 firmware ABI. */
+		npu_firmware: npu-firmware@84000000 {
+			reg = <0x84000000 0x400000>;
+			no-map;
+		};
+
+		npu_pkt: npu-pkt@84400000 {
+			reg = <0x84400000 0x1600000>;
+			no-map;
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&an7563_pinctrl 5 GPIO_ACTIVE_LOW>;
+			debounce-interval = <10>;
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+
+		led_status_green: led-0 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_GREEN>;
+			gpios = <&an7563_pinctrl 8 GPIO_ACTIVE_HIGH>;
+		};
+
+		led_status_red: led-1 {
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_RED>;
+			gpios = <&an7563_pinctrl 9 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
+
+&an7563_pinctrl {
+	wifi-reset-hog {
+		gpio-hog;
+		gpios = <6 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "wifi-reset";
+	};
+
+	mdio_pins: mdio-pins {
+		mux {
+			function = "mdio";
+			groups = "mdio";
+		};
+	};
+
+	pcie0_rst_pins: pcie0-rst-pins {
+		conf {
+			pins = "pcie_reset0";
+			drive-open-drain;
+		};
+	};
+};
+
+&npu {
+	memory-region = <&npu_firmware>, <&npu_pkt>;
+	memory-region-names = "firmware", "pkt";
+	status = "okay";
+};
+
+&eth {
+	status = "okay";
+};
+
+&gdm1 {
+	status = "okay";
+	nvmem-cells = <&macaddr_factory_4 (-16)>;
+	nvmem-cell-names = "mac-address";
+};
+
+&gdm2 {
+	phy-handle = <&phy15>;
+	status = "okay";
+	nvmem-cells = <&macaddr_factory_4 (-15)>;
+	nvmem-cell-names = "mac-address";
+};
+
+&hsgmii_pcs {
+	status = "okay";
+};
+
+&switch {
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&mdio_pins>;
+};
+
+&gsw_port2 {
+	label = "lan2";
+	status = "okay";
+};
+
+&gsw_port3 {
+	label = "lan3";
+	status = "okay";
+};
+
+&gsw_port4 {
+	label = "lan4";
+	status = "okay";
+};
+
+&gsw_mdio {
+	phy15: ethernet-phy@f {
+		compatible = "ethernet-phy-id03a2.a411";
+		reg = <15>;
+		reset-gpios = <&an7563_pinctrl 13 GPIO_ACTIVE_LOW>;
+		reset-assert-us = <250000>;
+		reset-deassert-us = <20000>;
+	};
+};
+
+&pcie0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pcie0_rst_pins>;
+	ranges = <0x82000000 0 0x20000000 0x20000000 0 0x4000000>;
+	status = "okay";
+
+	pcie@0,0 {
+		reg = <0x0000 0 0 0 0>;
+		device_type = "pci";
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		wifi@0,0 {
+			compatible = "pci14c3,7992";
+			reg = <0x0000 0 0 0 0>;
+			airoha,npu = <&npu>;
+			airoha,eth = <&eth>;
+			nvmem-cells = <&eeprom_factory_0>;
+			nvmem-cell-names = "eeprom";
+		};
+	};
+};
+
+&pcie1 {
+	ranges = <0x82000000 0 0x24000000 0x24000000 0 0x4000000>;
+	status = "okay";
+};
+
+&snfi {
+	status = "okay";
+};
+
+&spi_nand {
+	airoha,bmt;
+	/* Prevent BMT metadata creation and automatic repair during RAM tests. */
+	airoha,bmt-read-only;
+
+	partitions {
+		compatible = "fixed-partitions";
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		partition@0 {
+			label = "Bootloader";
+			reg = <0x0 0x80000>;
+			read-only;
+		};
+
+		partition@80000 {
+			label = "u-boot-env";
+			reg = <0x80000 0x80000>;
+			read-only;
+		};
+
+		partition@100000 {
+			label = "Factory";
+			reg = <0x100000 0x400000>;
+			read-only;
+
+			nvmem-layout {
+				compatible = "fixed-layout";
+				#address-cells = <1>;
+				#size-cells = <1>;
+
+				eeprom_factory_0: eeprom@0 {
+					reg = <0x0 0x1e00>;
+				};
+
+				macaddr_factory_4: macaddr@4 {
+					compatible = "mac-base";
+					reg = <0x4 0x6>;
+					#nvmem-cell-cells = <1>;
+				};
+			};
+		};
+
+		partition@500000 {
+			label = "KernelFS1";
+			reg = <0x500000 0x27c0000>;
+			read-only;
+		};
+
+		partition@2cc0000 {
+			label = "KernelFS2";
+			reg = <0x2cc0000 0x27c0000>;
+			read-only;
+		};
+
+		partition@5480000 {
+			label = "CFM";
+			reg = <0x5480000 0x800000>;
+			read-only;
+		};
+
+		partition@5c80000 {
+			label = "CFM_BACKUP";
+			reg = <0x5c80000 0x800000>;
+			read-only;
+		};
+
+		partition@6480000 {
+			label = "CFG";
+			reg = <0x6480000 0x400000>;
+			read-only;
+		};
+
+		partition@6880000 {
+			label = "MISC2";
+			reg = <0x6880000 0x400000>;
+			read-only;
+		};
+
+		partition@6c80000 {
+			label = "art";
+			reg = <0x6c80000 0x380000>;
+			read-only;
+		};
+	};
+};
diff --git a/target/linux/airoha/image/an7563a64.mk b/target/linux/airoha/image/an7563a64.mk
