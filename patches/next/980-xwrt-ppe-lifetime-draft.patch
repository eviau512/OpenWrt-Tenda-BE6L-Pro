+static bool
+airoha_ppe_foe_slot_busy(struct airoha_ppe *ppe,
+			struct airoha_flow_table_entry *owner, u32 hash)
+{
+	lockdep_assert_held(&ppe_lock);
+	return ppe->foe_owner[hash] && ppe->foe_owner[hash] != owner;
